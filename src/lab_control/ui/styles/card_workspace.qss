/* Graphite workspace theme.
   Colors are the literal values of ui/styles/tokens.py; components live in ui/kit.
   Metrics follow the approved graphite demo: 32 px controls, 26 px small buttons,
   10 px card radius, 7 px control radius, 13 px body text. @assets@ is replaced by
   app.load_stylesheet() with this folder (check marks, spin arrows). */

/* ---------------------------------------------------------------- base */
QWidget { color: #ececee; background: #0f1012; font-size: 13px; }
QLabel { background: transparent; }
QToolTip { color: #ececee; background: #1c1d21; border: 1px solid #34363d; border-radius: 6px; padding: 6px 8px; }
QDialog, QMessageBox, QInputDialog, QFileDialog { background: #16171a; }
QScrollArea { border: 0; background: transparent; }
QSplitter::handle { background: transparent; }
QSplitter::handle:horizontal { width: 12px; }
QSplitter::handle:vertical { height: 12px; }

/* ---------------------------------------------------------------- typography */
QLabel#pageTitle, QLabel[role="title"] { color: #ececee; font-size: 20px; font-weight: 700; }
QLabel#pageDescription, QLabel[role="caption"] { color: #6e7179; font-size: 12px; }
QLabel#eyebrow { color: #6e7179; font-size: 11px; }
QLabel#overviewNote { color: #6e7179; font-size: 12px; }
QLabel#panelTitle, QLabel[role="heading"], QLabel#cardTitle { color: #ececee; font-size: 14px; font-weight: 600; }
QLabel[role="muted"], QLabel#readback, QLabel#mutedText { color: #a3a5ac; font-size: 12px; }
QLabel[role="value"] { color: #ececee; font-size: 15px; font-weight: 600; }
QLabel#rangeHint { color: #6e7179; font-size: 11px; }
QLabel#inputFeedback { color: #ee9a48; font-size: 12px; }
QLabel#controlTitle { color: #a3a5ac; font-size: 12px; font-weight: 400; }
QLabel#sectionTitle { color: #ececee; font-size: 12px; font-weight: 600; }
QLabel#kbd { color: #6e7179; border: 1px solid #34363d; border-radius: 4px; padding: 0 5px; font-size: 11px; }

/* ---------------------------------------------------------------- buttons */
QPushButton, QToolButton#kitButton {
    background: #1c1d21; border: 1px solid #34363d; border-radius: 7px;
    color: #ececee; padding: 0 12px; min-height: 30px; font-weight: 500;
}
QPushButton:hover { background: #222428; border-color: #43464e; }
QPushButton:pressed { background: #2a2c31; }
QPushButton:focus { border-color: #43464e; }
QPushButton:disabled { color: #4f525a; background: #16171a; border-color: #25272c; }
QPushButton::menu-indicator { image: none; width: 0; }
QPushButton#mcpExportMenu { padding-right: 22px; }
QPushButton#mcpExportMenu::menu-indicator {
    image: url("@assets@/spin-down.svg"); width: 10px; height: 10px;
    subcontrol-position: center right; subcontrol-origin: padding; right: 6px;
}
QPushButton#primaryButton, QPushButton[variant="primary"] { background: #ee9a48; border-color: #ee9a48; color: #1b1207; font-weight: 600; }
QPushButton#primaryButton:hover, QPushButton[variant="primary"]:hover { background: #f4ab62; border-color: #f4ab62; }
QPushButton#primaryButton:pressed, QPushButton[variant="primary"]:pressed { background: #d98a3e; border-color: #d98a3e; }
QPushButton#primaryButton:disabled, QPushButton[variant="primary"]:disabled { background: #2b2118; border-color: #2b2118; color: #9a7a55; }
QPushButton#dangerButton, QPushButton[variant="danger"] { color: #f2555a; background: #2a1719; border-color: #6b2f33; }
QPushButton#dangerButton:hover, QPushButton[variant="danger"]:hover { background: #3a1d20; border-color: #8a3a3f; }
QPushButton[variant="ghost"] { background: transparent; border-color: transparent; color: #a3a5ac; }
QPushButton[variant="ghost"]:hover { background: #222428; color: #ececee; }
QPushButton[variant="ghost"]:disabled { background: transparent; color: #4f525a; }
QPushButton[variant="link"] { background: transparent; border: 0; color: #ee9a48; padding: 0; min-height: 0; }
QPushButton[variant="link"]:hover { color: #f4ab62; }
QPushButton[variant="link"]:disabled { color: #4f525a; }
QPushButton[kitSize="sm"] { min-height: 24px; max-height: 24px; padding: 0 9px; border-radius: 6px; font-size: 12px; }
QPushButton[kitSize="lg"] { min-height: 34px; max-height: 34px; padding: 0 16px; }
QToolButton#iconButton { border: 0; border-radius: 7px; background: transparent; }
QToolButton#iconButton:hover { background: #222428; }
QToolButton#iconButton:pressed, QToolButton#iconButton:checked { background: #2a2c31; }
QToolButton#iconButton:disabled { background: transparent; }

/* ---------------------------------------------------------------- inputs */
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #121315; border: 1px solid #34363d; border-radius: 7px; padding: 0 10px; min-height: 30px;
    selection-background-color: #5a3f24; selection-color: #ececee;
}
QComboBox { padding-right: 26px; }
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #43464e; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #ee9a48; }
QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { color: #6e7179; background: #16171a; border-color: #25272c; }
QComboBox::drop-down { border: 0; width: 28px; }
QComboBox::down-arrow { image: none; width: 0; height: 0; }
QLineEdit { placeholder-text-color: #6e7179; }
QSpinBox::up-button, QDoubleSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::down-button { width: 18px; border: 0; background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url("@assets@/spin-up.svg"); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url("@assets@/spin-down.svg"); width: 10px; height: 10px; }
QFrame#workspaceChoicePopup { background: transparent; border: 0; }
QWidget#slotChoiceHeader { background: #1c1d21; }
QListView#workspaceChoices { background: #1c1d21; border: 0; padding: 0; outline: 0; }
QWidget#workspaceChoicesViewport { background: #1c1d21; font-size: 13px; }

/* One frame around value + unit (kit.FieldBox). */
QFrame#fieldBox { background: #121315; border: 1px solid #34363d; border-radius: 7px; }
QFrame#fieldBox:hover { border-color: #43464e; }
QFrame#fieldBox[dirty="true"] { border-color: #8a5d32; }
QFrame#fieldBox[focus="true"] { border-color: #ee9a48; }
QFrame#fieldBox[error="true"] { border-color: #f2555a; }
QFrame#fieldBox:disabled { background: #16171a; border-color: #25272c; }
QFrame#fieldBox QLineEdit, QFrame#fieldBox QLineEdit:hover, QFrame#fieldBox QLineEdit:focus {
    background: transparent; border: 0; border-radius: 0; padding: 0 10px; min-height: 30px;
}
QFrame#fieldBox QLineEdit:disabled { background: transparent; color: #6e7179; }
QFrame#fieldBox QComboBox, QFrame#fieldBox QComboBox:hover, QFrame#fieldBox QComboBox:focus {
    background: transparent; border: 0; border-left: 1px solid #25272c; border-radius: 0;
    color: #a3a5ac; padding: 0 22px 0 9px; min-height: 30px; font-size: 12px;
}
QFrame#fieldBox QComboBox:disabled { background: transparent; color: #4f525a; }

QCheckBox, QRadioButton { spacing: 8px; padding: 4px 0; background: transparent; }
QCheckBox::indicator, QAbstractItemView::indicator, QGroupBox::indicator, QMenu::indicator:non-exclusive {
    width: 14px; height: 14px; border-radius: 4px; background: #121315; border: 1px solid #4f525a; image: none;
}
QRadioButton::indicator { width: 14px; height: 14px; border-radius: 8px; background: #121315; border: 1px solid #4f525a; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked, QGroupBox::indicator:checked, QMenu::indicator:non-exclusive:checked {
    background: #ee9a48; border-color: #ee9a48; image: url("@assets@/check.svg");
}
QRadioButton::indicator:checked { background: #121315; border: 4px solid #ee9a48; width: 8px; height: 8px; }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background: #ee9a48; border-color: #ee9a48; image: url("@assets@/dash.svg"); }
QCheckBox::indicator:hover, QCheckBox::indicator:focus, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover, QGroupBox::indicator:hover { border-color: #f4ab62; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled, QAbstractItemView::indicator:disabled, QGroupBox::indicator:disabled { background: #16171a; border-color: #34363d; }
QCheckBox::indicator:checked:disabled, QAbstractItemView::indicator:checked:disabled, QGroupBox::indicator:checked:disabled { background: #34363d; border-color: #34363d; image: url("@assets@/check-disabled.svg"); }
QCheckBox#kitSwitch { padding: 0; }
QCheckBox#kitSwitch::indicator { width: 0; height: 0; border: 0; background: transparent; image: none; }

QSlider { min-height: 20px; background: transparent; }
QSlider::groove:horizontal { height: 4px; border-radius: 2px; background: #34363d; }
QSlider::sub-page:horizontal { height: 4px; border-radius: 2px; background: #c9813e; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; background: #ececee; border: 0; }
QSlider::handle:horizontal:hover { background: #ffffff; }
QSlider::sub-page:horizontal:disabled { background: #34363d; }
QSlider::handle:horizontal:disabled { background: #6e7179; }

/* ---------------------------------------------------------------- scroll, menus, tabs, tables */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px 2px 2px 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0 2px 2px 2px; }
QScrollBar::handle { background: #2c2e34; border-radius: 3px; min-height: 28px; min-width: 28px; margin: 0 2px; }
QScrollBar::handle:horizontal { margin: 2px 0; }
QScrollBar::handle:hover { background: #3a3d44; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QMenu { background: #1c1d21; border: 1px solid #34363d; border-radius: 8px; padding: 5px; font-size: 13px; }
QMenu#workspaceActionMenu { background: transparent; border: 0; margin: 8px; }
QMenu::item { height: 18px; padding: 8px 26px 8px 12px; border-radius: 5px; color: #ececee; }
QMenu::item:selected { background: #222428; color: #ececee; }
QMenu::item:disabled { color: #6e7179; }
QMenu::separator { height: 1px; background: #25272c; margin: 5px 6px; }
QMenu::icon { padding-left: 8px; }
QTabWidget::pane { border: 1px solid #25272c; border-radius: 10px; background: #16171a; top: -1px; }
QTabBar::tab { background: transparent; color: #a3a5ac; padding: 9px 14px; border-bottom: 2px solid transparent; }
QTabBar::tab:hover { color: #ececee; }
QTabBar::tab:selected { color: #ececee; border-bottom-color: #ee9a48; font-weight: 600; }
QTreeWidget, QTextBrowser { background: #16171a; alternate-background-color: #18191c; border: 1px solid #25272c; border-radius: 10px; selection-background-color: #2f2419; selection-color: #ececee; padding: 6px; }
QTreeWidget::item { min-height: 28px; padding: 3px 6px; border-bottom: 1px solid #1f2125; }
QTreeWidget::item:selected { background: #2f2419; color: #ececee; }
QTreeWidget::item:hover { background: #1f2024; }
QHeaderView { background: transparent; }
QHeaderView::section { color: #6e7179; background: #16171a; padding: 8px; border: 0; border-bottom: 1px solid #25272c; font-size: 11px; }
QTextBrowser { padding: 12px; }
QTableView { background: #16171a; gridline-color: #25272c; alternate-background-color: #18191c; selection-background-color: #2f2419; selection-color: #ececee; border: 1px solid #25272c; border-radius: 10px; }
QTableView QTableCornerButton::section { background: #16171a; border: 0; }
QListWidget { background: #16171a; border: 1px solid #25272c; border-radius: 7px; outline: 0; }
QListWidget::item { padding: 6px 8px; border-radius: 5px; }
QListWidget::item:hover { background: #1f2024; }
QListWidget::item:selected { background: #2f2419; color: #ececee; }
QProgressBar { border: 1px solid #34363d; border-radius: 4px; background: #121315; color: #ececee; text-align: center; height: 16px; }
QProgressBar::chunk { background: #ee9a48; border-radius: 3px; }

/* ---------------------------------------------------------------- shell */
QWidget#cardWorkspace { background: #0f1012; }
QFrame#workspaceSidebar { background: #0b0c0e; border-right: 1px solid #25272c; }
QWidget#sidebarCategories { background: transparent; }
QLabel#commandBrand { font-size: 14px; font-weight: 700; color: #ececee; }
QLabel#commandEyebrow, QLabel#sidebarSection { color: #6e7179; font-size: 11px; }
QLabel#sidebarSection { margin-left: 7px; }
QPushButton#workspaceNav, QPushButton#workspaceSubNav {
    text-align: left; color: #a3a5ac; border: 0; border-radius: 7px; padding: 0 10px; min-height: 0; background: transparent;
}
QFrame#runtimeBadge { background: #16171a; border: 1px solid #25272c; border-radius: 7px; }
QFrame#runtimeBadge .QWidget { background: transparent; }
QComboBox#deviceCombo { background: transparent; border: 0; padding: 0; min-height: 54px; max-height: 54px; }
QLabel#runtimeBadgeText { color: #a3a5ac; font-size: 12px; }
QLabel#modeBadge { background: #2b2118; border: 1px solid #5a4126; border-radius: 7px; color: #f3b97c; padding: 7px 8px; font-size: 11px; }
QLabel#runtimeBadge { background: #16171a; border: 1px solid #25272c; border-radius: 7px; color: #a3a5ac; padding: 7px 8px; font-size: 11px; }
QFrame#commandHeader { background: #0f1012; border-bottom: 1px solid #25272c; }
QLabel#commandModuleTitle { color: #ececee; font-size: 15px; font-weight: 600; }
QLabel#commandBreadcrumb { color: #6e7179; font-size: 13px; }
QLabel#commandClock { color: #6e7179; font-size: 12px; padding-left: 4px; }
QFrame#searchBox { background: #16171a; border: 1px solid #25272c; border-radius: 7px; min-height: 30px; max-height: 30px; }
QFrame#searchBox:hover { border-color: #34363d; }
QFrame#searchBox QLineEdit#searchInput, QFrame#searchBox QLineEdit#searchInput:focus {
    background: transparent; border: 0; padding: 0; min-height: 28px; color: #ececee;
}
QTabBar#commandSubnav { background: transparent; border: 0; }
QTabBar#commandSubnav::tab { background: transparent; color: #a3a5ac; padding: 9px 14px; border-bottom: 2px solid transparent; font-size: 13px; }
QTabBar#commandSubnav::tab:hover { color: #ececee; }
QTabBar#commandSubnav::tab:selected { color: #ececee; border-bottom-color: #ee9a48; font-weight: 600; }
QTabBar#commandSubnav QToolButton { background: #1c1d21; color: #a3a5ac; border: 1px solid #34363d; border-radius: 5px; }
QFrame#appStatusBar { background: #0f1012; border-top: 1px solid #25272c; }
QLabel#appStatusText { color: #6e7179; font-size: 12px; }
QLabel#appStatusText[kind="err"] { color: #f2555a; }
QLabel#appStatusText[kind="warn"] { color: #e2c34a; }
QLabel#commandStatusBar { color: #a3a5ac; background: transparent; font-size: 12px; padding: 0; border: 0; }
QLabel#commandStatusBar[kind="err"] { color: #f2555a; }
QListView#searchResults { background: #1c1d21; border: 1px solid #34363d; border-radius: 8px; padding: 4px; outline: 0; }
QListView#searchResults::item { padding: 6px 8px; border-radius: 5px; }
QListView#searchResults::item:selected { background: #222428; color: #ececee; }
QWidget#workspaceStack { background: #0f1012; }

/* ---------------------------------------------------------------- component kit */
QFrame[kitCard="true"] { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame[kitCard="true"][hoverable="true"]:hover { background: #18191d; border-color: #34363d; }
QFrame[kitCard="true"] QWidget#cardBody { background: transparent; }
QFrame#cardHead { background: transparent; border: 0; border-bottom: 1px solid #25272c; border-top-left-radius: 10px; border-top-right-radius: 10px; }
QFrame#cardFoot { background: transparent; border: 0; border-top: 1px solid #25272c; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
QFrame#cardHead .QWidget, QFrame#cardFoot .QWidget { background: transparent; }
QFrame[kitCard="true"] .QWidget, QFrame[kitCard="true"] QStackedWidget { background: transparent; }
QFrame#kitSeparator { background: #25272c; border: 0; }
QFrame#panelSection { background: transparent; border: 0; border-bottom: 1px solid #25272c; }
QFrame#panelSection[last="true"] { border-bottom: 0; }
QFrame#panelSection .QWidget { background: transparent; }
QFrame#emptyState { background: transparent; border: 1px dashed #34363d; border-radius: 10px; }
QLabel#emptyTitle { color: #ececee; font-size: 15px; font-weight: 600; }
QLabel#emptyText { color: #6e7179; font-size: 13px; }
QFrame#kitHint { background: #1d1914; border: 1px solid #4a3520; border-radius: 7px; }
QFrame#kitHint[kind="err"] { background: #241517; border-color: #5c2a2e; }
QFrame#kitHint[kind="warn"] { background: #221f15; border-color: #4f4524; }
QLabel#hintText { color: #a3a5ac; font-size: 12px; }

QFrame#statusPill { border-radius: 11px; border: 1px solid transparent; background: #1c1d21; }
QFrame#statusPill QLabel#statusPillText { color: #a3a5ac; font-size: 12px; font-weight: 500; }
QFrame#statusPill[kind="neutral"] { border-color: #25272c; }
QFrame#statusPill[kind="ok"] { background: #16261c; }
QFrame#statusPill[kind="ok"] QLabel#statusPillText { color: #3fbf6f; }
QFrame#statusPill[kind="warn"] { background: #29251a; }
QFrame#statusPill[kind="warn"] QLabel#statusPillText { color: #e2c34a; }
QFrame#statusPill[kind="err"] { background: #2d191b; }
QFrame#statusPill[kind="err"] QLabel#statusPillText { color: #f2555a; }
QFrame#statusPill[kind="accent"] { background: #2b2118; }
QFrame#statusPill[kind="accent"] QLabel#statusPillText { color: #f3b97c; }
QFrame#statusPill[kind="info"] { background: #172230; }
QFrame#statusPill[kind="info"] QLabel#statusPillText { color: #6ab0ff; }

QFrame#segmented, QFrame#deviceChips { background: #1c1d21; border: 1px solid #25272c; border-radius: 7px; }
QFrame#segmented QPushButton[segItem="true"], QFrame#deviceChips QPushButton[segItem="true"] {
    min-height: 24px; max-height: 24px; padding: 0 11px; border: 1px solid transparent; border-radius: 5px;
    background: transparent; color: #a3a5ac; font-weight: 400;
}
QFrame#segmented QPushButton[segItem="true"]:hover, QFrame#deviceChips QPushButton[segItem="true"]:hover { color: #ececee; background: transparent; }
QFrame#segmented QPushButton[segItem="true"]:checked, QFrame#deviceChips QPushButton[segItem="true"]:checked {
    background: #16171a; color: #ececee; border-color: #34363d; font-weight: 600;
}
QFrame#segmented QPushButton[segItem="true"]:disabled { color: #4f525a; }
QFrame#segmented[small="true"] QPushButton[segItem="true"] { min-height: 20px; max-height: 20px; padding: 0 8px; font-size: 12px; }


QFrame#readoutStrip { background: #16171a; border: 1px solid #25272c; border-radius: 7px; }
QFrame#readoutStrip[embedded="true"] { background: transparent; border: 0; border-radius: 0; }
QFrame#readoutCell { border: 0; border-right: 1px solid #25272c; background: transparent; }
QFrame#readoutCell[highlight="true"] { background: #1a1714; }
QLabel#readoutLabel { color: #6e7179; font-size: 11px; }
QLabel#readoutValue { color: #ececee; font-size: 15px; font-weight: 600; }
QFrame#readoutCell[highlight="true"] QLabel#readoutValue { color: #f3b97c; }

/* Instrument chart and parameter cards (spectrum, oscilloscope, power, optical). */
QFrame#chartCard, QFrame#paramCard { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#chartCard QWidget#cardBody, QFrame#paramCard QWidget#cardBody { background: transparent; }
QFrame#chartCard[recordingFrame="true"] { border-width: 2px; }
QFrame#chartCard[recordingPhase="recording"], QFrame#chartCard[recordingPhase="draining"] { border-color: #b96360; }
QLabel#chartStatus { color: #a3a5ac; font-size: 12px; }
QLabel#chartMeta { color: #6e7179; font-size: 12px; }
QLabel#panelHint { color: #6e7179; font-size: 11px; }
QLabel#pageEmpty { color: #6e7179; font-size: 14px; border: 1px dashed #34363d; border-radius: 10px; padding: 32px; background: transparent; }
QFrame[chartCard="true"] .QWidget { background: transparent; }
QFrame#paramCard QScrollArea, QFrame#paramCard QScrollArea > .QWidget > .QWidget { background: transparent; border: 0; }
QWidget#paramCard { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QWidget#paramCard QScrollArea, QWidget#paramCard QWidget#cardBody { background: transparent; border: 0; }

/* ---------------------------------------------------------------- overview */
QScrollArea#categoryGrid, QWidget#categoryGridBody { background: #0f1012; border: 0; }
QFrame#categoryCard { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#categoryCard:hover, QFrame#categoryCard:focus { background: #18191d; border-color: #34363d; }
QFrame#categoryCard .QWidget { background: transparent; }
QLabel#cardIcon { color: #ee9a48; font-size: 9px; }
QLabel#cardVisibility { color: #6e7179; font-size: 11px; }
QLabel#cardDescription, QLabel#cardMeta, QLabel#metricCaption { color: #6e7179; font-size: 12px; }
QLabel#cardValue { color: #ececee; font-size: 22px; font-weight: 700; }
QLabel#overviewTitle { color: #ececee; font-size: 22px; font-weight: 700; }
QLabel#cardDeviceName { color: #ececee; font-size: 13px; font-weight: 600; }
QLabel#cardDeviceDetail { color: #6e7179; font-size: 13px; }
QLabel#cardDeviceState { color: #a3a5ac; font-size: 13px; }
QLabel#cardDeviceState[alert="true"], QLabel#metricValue[alert="true"] { color: #f2555a; }
QLabel#cardLinkText { color: #ee9a48; font-size: 12px; }
QLabel#metricValue { color: #a3a5ac; font-size: 12px; font-weight: 600; }
QFrame#overviewTrend, QFrame#overviewSide { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#overviewSide .QWidget { background: transparent; }
QFrame#alarmItem { background: #241517; border: 1px solid #5c2a2e; border-radius: 7px; }
QFrame#taskRow { background: transparent; border: 0; border-bottom: 1px solid #25272c; }
QLabel#taskTitle { color: #ececee; font-size: 13px; font-weight: 600; }
QLabel#taskMeta { color: #6e7179; font-size: 12px; }
QLabel#taskTime { color: #a3a5ac; font-size: 12px; }

/* ---------------------------------------------------------------- device pool */
QFrame#devicePoolOverlay { background: transparent; }
QFrame#devicePoolDialog { background: #16171a; border: 1px solid #34363d; border-radius: 14px; }
QWidget#devicePoolViewport, QWidget#devicePoolWide, QStackedWidget#devicePoolPages, QWidget#poolListViewport { background: #16171a; }
QWidget#poolInfoCell { background: transparent; }
QScrollArea#devicePoolScroll, QWidget#devicePoolBody, QFrame#devicePoolDetails { background: #16171a; border: 0; }
QFrame#poolListPanel { background: transparent; border: 0; }
QFrame#poolInfoCard { background: #1c1d21; border: 1px solid #25272c; border-radius: 8px; }
QLabel#poolTitle { color: #ececee; font-size: 19px; font-weight: 600; }
QLabel#poolDeviceName { color: #ececee; font-size: 17px; font-weight: 600; }
QLabel#poolGroupTitle { color: #a3a5ac; font-size: 12px; font-weight: 600; }
QLabel#poolCaption { color: #6e7179; font-size: 11px; }
QLabel#poolField { color: #ececee; font-size: 12px; }
QLabel#poolEmpty { color: #a3a5ac; background: #1c1d21; border: 1px dashed #34363d; border-radius: 8px; padding: 14px; }
QPushButton#poolClose { color: #a3a5ac; background: transparent; border: 1px solid #34363d; border-radius: 8px; padding: 0; font-size: 20px; }
QPushButton#poolClose:hover { color: #ececee; background: #222428; border-color: #43464e; }
QPushButton#poolStop { color: #f3b97c; border-color: #6b4c2d; }
QPushButton[poolAction="true"] { color: #ececee; background: #1c1d21; border: 1px solid #34363d; border-radius: 7px; font-size: 13px; }
QPushButton[poolAction="true"]:hover, QPushButton[poolAction="true"]:focus { color: #ececee; background: #222428; border-color: #43464e; }
QPushButton[poolAction="true"]:disabled { color: #4f525a; background: #16171a; border-color: #25272c; }
QPushButton#poolMore::menu-indicator { image: none; width: 0; }
QTreeWidget#poolDeviceList { background: transparent; border: 0; padding: 0; outline: 0; }
QLabel#poolConnectionError { color: #f2555a; background: #241517; border: 1px solid #5c2a2e; border-radius: 7px; padding: 10px 12px; }
QListWidget#staticAddressList { background: #121315; border: 1px solid #34363d; border-radius: 7px; }
QListWidget#staticAddressList::item { padding: 7px 9px; border-bottom: 1px solid #25272c; border-radius: 0; }
QListWidget#staticAddressList::item:selected { background: #2f2419; color: #f3b97c; }

/* ---------------------------------------------------------------- watchlists, log, settings */
QSplitter#watchSplit::handle { background: transparent; }
QFrame#watchPresetPane { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#watchPresetPane .QWidget { background: transparent; }
QListWidget#watchPresets { background: transparent; border: 0; padding: 0; outline: 0; selection-background-color: #1c1d21; selection-color: #ececee; }
QListWidget#watchPresets::item { min-height: 24px; padding: 6px 10px; border-radius: 7px; }
QListWidget#watchPresets::item:hover { background: #222428; }
QListWidget#watchPresets::item:selected { background: #1c1d21; color: #ececee; font-weight: 700; }
QTableView#watchReadings { background: #16171a; border: 1px solid #25272c; border-radius: 10px; selection-background-color: #23201b; alternate-background-color: #18191c; }
QTableView#watchReadings::item { padding: 0 7px; border-bottom: 1px solid #1f2125; }
QTableView#watchReadings::item:selected { background: #23201b; color: #ececee; }
QTableView#watchReadings QHeaderView::section { font-size: 12px; padding: 7px; }
QTableView#watchReadings QLineEdit { padding: 0 4px; min-height: 0; }
QTreeWidget#watchSignalTree { font-size: 14px; }
QDialog#watchWindow QTableView#watchReadings,
QDialog#watchWindow QTableView#watchReadings QLineEdit { font-size: 34px; }
QDialog#watchWindow QTableView#watchReadings QHeaderView,
QDialog#watchWindow QTableView#watchReadings QHeaderView::section { font-size: 28px; }
QDialog#watchWindow > QWidget > QPushButton { font-size: 30px; }
QLabel#watchEmpty { color: #6e7179; font-size: 13px; background: transparent; }
QLabel#watchHint { color: #6e7179; font-size: 11px; padding-left: 4px; }
QLabel#watchSummary { color: #a3a5ac; font-size: 12px; padding: 0 6px; }
QFrame#logFilters { background: #1c1d21; border: 1px solid #25272c; border-radius: 7px; }
QPushButton#logFilter { min-height: 24px; max-height: 24px; padding: 0 10px; border: 1px solid transparent; border-radius: 5px; background: transparent; color: #a3a5ac; font-size: 12px; }
QPushButton#logFilter:hover { color: #ececee; background: transparent; }
QPushButton#logFilter:checked { background: #16171a; color: #ececee; border-color: #34363d; font-weight: 700; }
QTableView#operationLogTable { background: #16171a; border: 1px solid #25272c; border-radius: 10px; alternate-background-color: #18191c; selection-background-color: #23201b; selection-color: #ececee; }
QTableView#operationLogTable::item { padding: 0 8px; border-bottom: 1px solid #1f2125; }
QScrollArea#settingsPage, QWidget#settingsBody { background: #0f1012; border: 0; }
QFrame#settingsSection { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#settingsSection .QWidget { background: transparent; }
QFrame#settingsSection QLineEdit, QFrame#settingsSection QComboBox, QFrame#settingsSection QSpinBox { background: #121315; }
QFrame#settingsSection QTreeWidget, QFrame#settingsSection QTableView, QFrame#settingsSection QTextBrowser, QFrame#settingsSection QListWidget { background: #121315; }
QPushButton#settingsJump { min-height: 24px; max-height: 24px; padding: 0 12px; border-radius: 12px; background: #1c1d21; border: 1px solid #25272c; color: #a3a5ac; font-size: 12px; }
QPushButton#settingsJump:hover { color: #ececee; border-color: #34363d; }

/* ---------------------------------------------------------------- monitoring dashboard cards */
QFrame#operationCard, QFrame#monitorCard { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#operationCard .QWidget, QFrame#monitorCard .QWidget { background: transparent; }
QFrame#monitorCard[recordingFrame="true"] { border-width: 2px; }
QFrame#monitorCard[recordingPhase="recording"], QFrame#monitorCard[recordingPhase="draining"] { border-color: #b96360; }
QLabel#monitorState { color: #a3a5ac; font-size: 12px; }
QLabel#monitorDetailsLink { color: #ee9a48; font-size: 12px; }
QLabel#monitorDetailsLink:hover { color: #f4ab62; }
QDialog#monitorDetailsDialog { background: #16171a; border: 1px solid #34363d; border-radius: 10px; }
QLabel#monitorDetailsHeading { color: #ececee; font-size: 13px; font-weight: 600; }
QLabel#monitorDetailsPath, QLabel#monitorDetailsMeta { color: #a3a5ac; font-size: 12px; }
QFrame#monitorCategory { background: transparent; border: 0; }
QLabel#monitorCategoryTitle { color: #ececee; font-size: 14px; font-weight: 700; padding: 5px 0; }
QLabel#monitorSlot { color: #a3a5ac; background: #1c1d21; border: 1px solid #25272c; border-radius: 6px; padding: 4px 7px; }
QFrame#scalarReadout { background: #1c1d21; border: 1px solid #25272c; border-radius: 7px; }
QFrame#scalarReadout QLabel { background: transparent; border: 0; }
QLabel#scalarReadoutChannel { color: #a3a5ac; font-size: 12px; font-weight: 600; }
QLabel#scalarReadoutUnit { color: #6e7179; font-size: 12px; }
QLabel#scalarReadoutValue { font-family: "Cascadia Mono", "Consolas", monospace; font-size: 20px; color: #ececee; }
QPushButton#cardLink { text-align: left; padding: 4px 0; border: 0; background: transparent; font-weight: 600; min-height: 0; }

/* ---------------------------------------------------------------- parameter editors */
QWidget#parameterEditor { background: transparent; }
QFrame#sourceGroup, QFrame#compactOperation { background: transparent; border: 0; }
QFrame#compactOperation QLabel#controlTitle { font-size: 12px; color: #a3a5ac; }
QFrame#compactOperation QLabel#readback { font-size: 11px; color: #6e7179; }
QFrame#compactOperation QLabel#rangeHint { font-size: 11px; color: #6e7179; }
QFrame#compactOperation QLabel#operationStatus { font-size: 11px; color: #a3a5ac; }
QLineEdit#sourceValue { font-size: 14px; font-weight: 600; }
QLineEdit#sourceValue[emptyInput="true"] { font-size: 13px; font-weight: 400; }
QFrame#operationCard QLabel#controlTitle { font-size: 14px; font-weight: 600; color: #ececee; }
QLabel#outputState { font-size: 13px; font-weight: 600; color: #a3a5ac; padding: 3px 5px; }

/* Signal source panels. */
QFrame#channelPanel { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#channelPanel .QWidget { background: transparent; }
QLabel#channelTitle { color: #ececee; background: transparent; padding: 9px 12px; font-size: 14px; font-weight: 600; }
QFrame#sourceChannelHeader { background: transparent; border: 0; border-bottom: 1px solid #25272c; }
QFrame#sourceChannelHeader QLabel#channelTitle { padding: 0; font-size: 15px; }
QFrame#sourceChannelHeader QLabel#outputState { color: #a3a5ac; font-size: 12px; font-weight: 400; padding: 0; }
QFrame#sourceChannelHeader QLabel#outputState[outputActive="true"] { color: #3fbf6f; }
QPushButton#sourceOutputButton { font-size: 12px; }
QFrame#sourceGroup[simplified="true"] QLabel#controlTitle { color: #a3a5ac; font-size: 12px; }
QFrame#sourceGroup[simplified="true"] QLabel#rangeHint { color: #6e7179; font-size: 11px; }
QFrame#sourceGroup[simplified="true"] QLineEdit#sourceValue { font-size: 16px; font-weight: 600; }
QFrame#sourceGroup[simplified="true"] QLineEdit#sourceValue[emptyInput="true"] { font-size: 13px; font-weight: 400; }
QFrame#sourceGroup QPushButton#primaryButton:disabled { background: #2b2118; color: #9a7a55; border-color: #2b2118; }
QPushButton#sourceSettingsButton { padding: 0 14px; }
QLabel#sourceConnectionState { color: #a3a5ac; font-size: 12px; padding: 0 6px; }
QDialog#sourceSettingsDialog { background: #16171a; border: 1px solid #34363d; border-radius: 12px; }
QLabel#sourceSettingsTitle { font-size: 18px; font-weight: 600; }
QPushButton#sourceSettingsClose { background: transparent; border: 0; padding: 0; min-height: 0; font-size: 22px; color: #a3a5ac; }
QPushButton#sourceSettingsClose:hover { background: #222428; color: #ececee; }
QFrame#sourceSettingsSection { background: #1c1d21; border: 1px solid #25272c; border-radius: 8px; }
QFrame#sourceSettingsSection .QWidget { background: transparent; }
QPushButton#referenceChoice { background: #121315; border-color: #34363d; }
QPushButton#referenceChoice:checked { background: #2b2118; border-color: #ee9a48; color: #f3b97c; }
QPushButton#referenceChoice:disabled { color: #4f525a; border-color: #25272c; }

/* Power supplies. */
QFrame#powerChannel { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#powerChannel .QWidget { background: transparent; }
QLabel#powerChannelTitle { color: #ececee; font-size: 15px; font-weight: 600; }
QLabel#powerSyncState { color: #a3a5ac; font-size: 12px; }
QFrame#powerChannel QLineEdit#powerValue { background: #121315; font-size: 18px; font-weight: 600; min-height: 32px; }
QFrame#powerChannel QLabel#powerMeasured { color: #f3b97c; font-size: 12px; }
QFrame#powerChannel QLabel#rangeHint { color: #6e7179; font-size: 11px; }
QLabel#powerOutputState { color: #a3a5ac; font-size: 12px; }
QPushButton#powerOutputButton { border-color: #6b4c2d; color: #f3b97c; }
QPushButton#powerOutputButton:disabled { color: #4f525a; border-color: #25272c; }
QFrame#powerMonitorChannel { background: #1c1d21; border: 1px solid #25272c; border-radius: 8px; }
QFrame#powerMonitorChannel .QWidget { background: transparent; }
QFrame#powerMonitorChannel QLineEdit { background: #121315; font-size: 14px; font-weight: 600; }
QLabel#powerLiveValue { font-size: 15px; font-weight: 600; color: #ececee; }
QFrame#powerMonitorChannel QLabel#rangeHint { font-size: 11px; color: #6e7179; }

/* CoreMorrow E00. */
QFrame#coremorrowChannel { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#coremorrowChannel .QWidget { background: transparent; }
QLabel#coremorrowChannelTitle { color: #ececee; font-size: 15px; font-weight: 600; }
QLabel#coremorrowChannelStatus { color: #a3a5ac; font-size: 12px; }
QFrame#coremorrowChannel QLineEdit#sourceValue { background: #121315; font-size: 16px; }
QLabel#coremorrowControlLabel { color: #a3a5ac; font-size: 12px; }
QPushButton#coremorrowStepButton { padding: 0 15px; }
QLabel#coremorrowActualTitle { color: #ececee; font-size: 13px; }
QLCDNumber#coremorrowActual { color: #ee9a48; background: #121315; border: 1px solid #34363d; border-radius: 7px; padding: 3px; }
QLabel#coremorrowActualUnit { color: #f3b97c; font-size: 12px; }
QLabel#coremorrowActualDetail { color: #a3a5ac; font-size: 11px; }
QFrame#coremorrowChannel QLabel#rangeHint { color: #6e7179; font-size: 11px; }
QFrame#coremorrowChannel[waveform="true"] QPushButton { min-width: 48px; padding: 0 6px; }
QFrame#coremorrowChannel[waveform="true"] QComboBox { min-width: 72px; }
QLabel#coremorrowWaveStatus { color: #a3a5ac; font-size: 12px; }
QFrame#phaseFrequency, QFrame#phaseFrequency QLabel { background: transparent; border: 0; }
QProgressBar#phaseProgress { height: 18px; }
QTableWidget#loadChannels { border: 1px solid #25272c; alternate-background-color: #18191c; }
QTableWidget#loadChannels::item { padding: 0 9px; border-bottom: 1px solid #1f2125; }
QTableWidget#loadChannels::item:selected { background: #2f2419; color: #f3b97c; }

/* ---------------------------------------------------------------- monitoring pages */
QFrame#spectrumChart { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#spectrumChart .QWidget { background: transparent; }
QFrame#spectrumChart QLabel { border: 0; background: transparent; }
/* Reserve the same frame width in every recording state; plots never jump. */
QFrame#spectrumChart[recordingFrame="true"] { border-width: 2px; }
QFrame#spectrumChart[recordingPhase="recording"], QFrame#spectrumChart[recordingPhase="draining"] { border-color: #b96360; }
QLabel#spectrumChartTitle { color: #ececee; font-size: 14px; font-weight: 600; }
QDoubleSpinBox#spectrumInterval {
    padding: 0 6px 0 10px; min-height: 28px; max-height: 28px; background: #16171a; border: 1px solid #25272c; font-weight: 600;
}
QDoubleSpinBox#spectrumInterval:hover { border-color: #34363d; }
QDoubleSpinBox#spectrumInterval:focus { border-color: #ee9a48; }
QToolButton#curveTools, QToolButton#recordButton, QToolButton#singleButton, QToolButton#runButton {
    background: #1c1d21; border: 1px solid #34363d; border-radius: 7px; padding: 0 12px; font-size: 13px; font-weight: 500; color: #ececee;
}
QToolButton#curveTools:hover, QToolButton#recordButton:hover, QToolButton#singleButton:hover, QToolButton#runButton:hover { background: #222428; border-color: #43464e; }
QToolButton#curveTools:disabled, QToolButton#recordButton:disabled, QToolButton#singleButton:disabled, QToolButton#runButton:disabled { background: #16171a; color: #4f525a; border-color: #25272c; }
QToolButton#curveTools::menu-indicator { image: none; width: 0; }
QToolButton#runButton { padding-right: 24px; }
QToolButton#runButton::menu-button { border: 0; border-left: 1px solid #34363d; width: 20px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; }
QToolButton#runButton::menu-button:hover { background: #2a2c31; }
QToolButton#runButton::menu-arrow { image: url("@assets@/spin-down.svg"); width: 10px; height: 10px; }
QToolButton#recordButton[recordingPhase="recording"] { background: #2a1719; color: #f2555a; border-color: #6b2f33; }
QToolButton#recordButton[recordingPhase="recording"]:hover { background: #3a1d20; border-color: #8a3a3f; }
QToolButton#recordButton[recordingPhase="draining"] { background: #1c1d21; color: #c29899; border-color: #6b2f33; }
QToolButton#curveTools:focus, QToolButton#recordButton:focus { border-color: #ee9a48; }
QFrame#spectrumControls { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#spectrumControls QWidget#cardBody, QFrame#spectrumControls QScrollArea > .QWidget > .QWidget { background: transparent; }
QLabel#spectrumHealth { border-radius: 10px; padding: 1px 9px; font-size: 12px; font-weight: 500; color: #a3a5ac; background: #1c1d21; }
QLabel#spectrumHealth[kind="ok"] { color: #3fbf6f; background: #16261c; }
QLabel#spectrumHealth[kind="warn"] { color: #e2c34a; background: #29251a; }
QLabel#spectrumHealth[kind="err"] { color: #f2555a; background: #2d191b; }
QLabel#spectrumHealth[kind="accent"] { color: #f3b97c; background: #2b2118; }
QFrame#spectrumControls QScrollArea { border: 0; background: transparent; }
QFrame#spectrumControls QFrame#compactOperation { border: 0; padding: 0; }
QFrame#spectrumControls QLabel#readback { font-size: 11px; color: #6e7179; }
QListWidget#spectrumMarkerList { background: transparent; border: 0; font-size: 12px; }
QListWidget#spectrumMarkerList::item { background: #1c1d21; border: 1px solid #25272c; border-radius: 7px; padding: 7px 10px; margin-bottom: 6px; }
QListWidget#spectrumMarkerList::item:hover { border-color: #34363d; }
QListWidget#spectrumMarkerList::item:selected { background: #2b2118; color: #f3b97c; border-color: #6b4c2d; }

QFrame#powerMeterWorkspace { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#powerMeterWorkspace .QWidget { background: transparent; }
QFrame#powerMeterWorkspace[recordingFrame="true"] { border-width: 2px; }
QFrame#powerMeterWorkspace[recordingPhase="recording"], QFrame#powerMeterWorkspace[recordingPhase="draining"] { border-color: #b96360; }
QWidget#powerMeterReadoutPanel { background: transparent; }
QFrame#powerMeterReadoutCard { background: #16171a; border: 1px solid #25272c; border-radius: 10px; min-height: 92px; max-height: 106px; }
QFrame#powerMeterReadoutCard QLabel { background: transparent; }
QFrame#powerMeterReadoutCard QCheckBox { background: transparent; padding: 0; spacing: 6px; }
QLabel#powerMeterTitle { color: #ececee; font-size: 14px; font-weight: 600; }
QLabel#powerMeterChannel { color: #ececee; font-size: 14px; font-weight: 600; }
QLabel#powerMeterValue { color: #ececee; font-size: 17px; font-weight: 600; padding: 1px 0; }
QLabel#powerMeterMeta, QLabel#powerMeterStatus { color: #6e7179; font-size: 11px; }
QLabel#powerMeterStatus[inputFault="true"] { color: #f2555a; }
QFrame#powerMeterReadoutList, QFrame#scanReadoutList { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#powerMeterReadoutList .QWidget, QFrame#scanReadoutList .QWidget { background: transparent; }
QFrame#scanReadoutCell { border: 0; border-bottom: 1px solid #1f2125; border-radius: 0; }
QFrame#scanReadoutCell:hover { background: #1c1d21; }
QFrame#scanReadoutCell QCheckBox { font-size: 12px; padding: 0; spacing: 6px; }
QLabel#scanReadoutValue, QLabel#scanReadoutUnit { color: #ececee; font-size: 13px; font-weight: 600; padding: 0; }
QLabel#scanReadoutSummary { color: #6e7179; font-size: 11px; }
QFrame#powerMeterReadoutRow { border: 0; border-bottom: 1px solid #1f2125; border-radius: 0; }
QFrame#powerMeterReadoutRow:hover { background: #1c1d21; }
QFrame#powerMeterReadoutRow QCheckBox { padding: 0; spacing: 0; }
QLabel#powerReadoutHeading { color: #6e7179; font-size: 11px; }
QLabel#powerReadoutChannel { font-size: 12px; font-weight: 600; }
QPushButton#powerReadoutValue { color: #ececee; font-size: 13px; font-weight: 600; text-align: right; padding: 0; min-height: 24px; max-height: 24px; border: 0; border-radius: 4px; background: transparent; }
QPushButton#powerReadoutValue:hover, QPushButton#powerReadoutValue:focus { background: #222428; color: #f3b97c; }
QLabel#powerReadoutPeak { color: #a3a5ac; font-size: 13px; }
QFrame#powerMeterReadoutRow[participating="false"] QPushButton#powerReadoutValue, QFrame#powerMeterReadoutRow[participating="false"] QLabel#powerReadoutPeak { color: #4f525a; }

/* Oscilloscope controls. */
QFrame#scopeControls { background: #16171a; border: 1px solid #25272c; border-radius: 10px; }
QFrame#scopeControls QScrollArea { border: 0; background: transparent; }
QFrame#scopeControls QWidget#cardBody, QFrame#scopeControls QStackedWidget, QFrame#scopeControls QStackedWidget > .QWidget { background: transparent; }
QToolButton#scopeFineButton { min-width: 52px; border: 1px solid #34363d; border-radius: 6px; color: #a3a5ac; background: #1c1d21; }
QToolButton#scopeFineButton:checked { color: #f3b97c; background: #2b2118; border-color: #6b4c2d; }
QToolButton#scopeFineButton:hover { border-color: #43464e; }
QToolButton#scopeFineButton:disabled { color: #4f525a; background: #16171a; border-color: #25272c; }
QFrame#scopeSection { background: transparent; border: 0; border-radius: 0; }
QFrame#scopeSection .QWidget { background: transparent; }
QFrame#scopeSection QLabel { border: 0; padding: 0; }
QLabel#scopeControlLabel { font-size: 12px; color: #a3a5ac; }
QLabel#scopeControlValue { font-size: 13px; font-weight: 600; color: #ececee; }
QLabel#scopeSampleRate { font-size: 12px; color: #a3a5ac; }
QLabel#scopeSampleRate[stale="true"] { color: #4f525a; }
QFrame#scopeSection QCheckBox { font-size: 13px; spacing: 7px; padding: 0; }
QFrame#scopeSection QToolButton { padding: 0 5px; min-height: 22px; font-size: 17px; border: 0; }
QLabel#scopeMeasurements { color: #a3a5ac; font-size: 12px; padding: 0; }

/* ---------------------------------------------------------------- explicit button sizes (last)
   Size belongs to the action group, never its color. Totals include the 1 px borders:
   compact 30, panel 36, dialog 38. */
QPushButton[buttonSize="compact"], QToolButton[buttonSize="compact"] {
    padding-top: 0; padding-bottom: 0; min-height: 28px; max-height: 28px;
}
QPushButton[buttonSize="panel"], QToolButton[buttonSize="panel"] {
    padding-top: 0; padding-bottom: 0; min-height: 34px; max-height: 34px;
}
QPushButton[buttonSize="dialog"], QToolButton[buttonSize="dialog"] {
    padding-top: 0; padding-bottom: 0; min-height: 36px; max-height: 36px;
}
